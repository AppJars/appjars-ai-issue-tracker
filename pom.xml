<?xml version="1.0" encoding="UTF-8"?>
<!--
  Issue Tracker — generated by Craft (https://craft.appjars.com).

  Several entries below look redundant and are not. Each one carries a comment saying what breaks
  without it. Keep them until you have read the comment.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>issue-tracker</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Issue Tracker</name>

    <properties>
        <java.version>21</java.version>
        <vaadin.version>25.2.9</vaadin.version>
        <!-- User Manager -->
        <appjars.user-manager.version>2.0.2</appjars.user-manager.version>
        <!-- Activity Log -->
        <appjars.activity-log.version>2.1.0</appjars.activity-log.version>
        <!-- Issue Tracker -->
        <appjars.issue-tracker.version>2.0.2</appjars.issue-tracker.version>
        <!-- Shared AppJars utilities (see dependencyManagement) -->
        <appjars.utils.version>2.0.3</appjars.utils.version>
    </properties>

    <repositories>
        <!-- AppJars artifacts are published here, not on Maven Central. Without this repository
             none of the com.appjars dependencies resolve. -->
        <repository>
            <id>appjars</id>
            <name>AppJars Public Repository</name>
            <url>https://maven.appjars.com</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <!-- Some add-ons the selected modules use are published to the Vaadin Directory. -->
        <repository>
            <id>vaadin-addons</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Every AppJar depends on these shared utilities, and AppJars are released one by one,
                 so different modules may ask for different versions. Without this pin Maven takes
                 the version of whichever module is declared first, which can be older than what
                 another module calls (NoSuchMethodError when a view opens). This is the highest
                 version any current AppJars release uses. Do not remove. -->
            <dependency>
                <groupId>com.appjars</groupId>
                <artifactId>appjars-flow-utils</artifactId>
                <version>${appjars.utils.version}</version>
            </dependency>
            <dependency>
                <groupId>com.appjars</groupId>
                <artifactId>appjars-business-utils</artifactId>
                <version>${appjars.utils.version}</version>
            </dependency>
            <dependency>
                <groupId>com.appjars</groupId>
                <artifactId>appjars-model-utils</artifactId>
                <version>${appjars.utils.version}</version>
            </dependency>
            <!-- Activity Log, Issue Tracker log through Log4j2.
                 Spring Boot's default logging starter (Logback) reaches the classpath through every
                 starter, direct or transitive; emptying it here removes Logback everywhere at once
                 instead of repeating an exclusion on each starter. Do not remove. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-logging</artifactId>
                <version>${project.parent.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>ch.qos.logback</groupId>
                        <artifactId>logback-classic</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-to-slf4j</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.slf4j</groupId>
                        <artifactId>jul-to-slf4j</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==== User Manager ===================================================================
             The three implementation modules of a monolithic integration. The API modules
             (-business, -data) and the -model module come in transitively.
             https://docs.appjars.com/user-manager/overview/ -->
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-user-manager-flow</artifactId>
            <version>${appjars.user-manager.version}</version>
        </dependency>
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-user-manager-data-impl</artifactId>
            <version>${appjars.user-manager.version}</version>
        </dependency>
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-user-manager-business-impl</artifactId>
            <version>${appjars.user-manager.version}</version>
        </dependency>
        <!-- ==== Activity Log ===================================================================
             The three implementation modules of a monolithic integration. The API modules
             (-business, -data) and the -model module come in transitively.
             https://docs.appjars.com/activity-log/overview/ -->
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-activity-log-flow</artifactId>
            <version>${appjars.activity-log.version}</version>
        </dependency>
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-activity-log-data-impl</artifactId>
            <version>${appjars.activity-log.version}</version>
        </dependency>
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-activity-log-business-impl</artifactId>
            <version>${appjars.activity-log.version}</version>
        </dependency>
        <!-- ==== Issue Tracker ===================================================================
             The three implementation modules of a monolithic integration. The API modules
             (-business, -data) and the -model module come in transitively.
             https://docs.appjars.com/issue-tracker/overview/ -->
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-issue-tracker-flow</artifactId>
            <version>${appjars.issue-tracker.version}</version>
        </dependency>
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-issue-tracker-data-impl</artifactId>
            <version>${appjars.issue-tracker.version}</version>
        </dependency>
        <dependency>
            <groupId>com.appjars</groupId>
            <artifactId>appjars-issue-tracker-business-impl</artifactId>
            <version>${appjars.issue-tracker.version}</version>
        </dependency>
        <!-- ================================================================================ -->

        <!-- AppJars persist through JPA; not every module pulls the starter in transitively. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Vaadin. vaadin-core contains only the free components. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <!-- Development-mode tooling (live reload, dev tools). Since Vaadin 25 it no longer arrives
             transitively and must be declared; optional keeps it out of downstream classpaths. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Log4j2 replaces Logback (see dependencyManagement). Configuration: src/main/resources/log4j2.xml -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- In-memory database for development. Point spring.datasource at a real database and
             swap this driver when you go further than evaluating. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <!-- Spring Boot 4 on an old Maven fails with confusing errors. Fail early instead. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>This project requires Maven 3.9 or newer (Spring Boot 4 / Vaadin 25).</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>This project requires Java 21 or newer.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Production build: mvn clean package -Pproduction -->
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>build-frontend</goal>
                                </goals>
                                <phase>compile</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <productionMode>true</productionMode>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
