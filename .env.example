# Compose reads this file after you copy it to .env. For Maven or IDE runs, export the settings
# into the application's environment instead.

# Host port where compose.yaml publishes the application.
APP_PORT=8080

# The application starts without the settings below; the corresponding screens report the missing setting.

# User Manager: AES key, only if you enable external authentication (optional)
# Spring property: com.appjars.usermanager.external-auth.secret.key
USER_MANAGER_EXTERNAL_AUTH_KEY=

# Issue Tracker: SMTP host, user and password for notification emails
# Spring property: spring.mail.host
SPRING_MAIL_HOST=

# Issue Tracker: SMTP host, user and password for notification emails
# Spring property: spring.mail.port
SPRING_MAIL_PORT=

# Issue Tracker: SMTP host, user and password for notification emails
# Spring property: spring.mail.username
SPRING_MAIL_USERNAME=

# Issue Tracker: SMTP host, user and password for notification emails
# Spring property: spring.mail.password
SPRING_MAIL_PASSWORD=
